{%- extends 'boot/generic-uboot-tftp.jinja2' %}
{%- set device_arch = "arm64" %}
{%- set sdk_arch = "aarch64" %}
{%- set device_mach = "renesas" %}
{%- set device_type = "r8a779g3-sparrow-hawk" %}
# this DTB is on linux-renesas only, not mainlined
{%- set dtb = dtb|default("r8a779g3-sparrow-hawk.dtb") %}
{%- set kernel_image = kernel_image|default("Image") %}
{%- set rootfs_type = rootfs_type|default("nbd") %}
{%- set uboot_type = "booti" %}

{%- if (build_type == 'daily') or (build_type == 'release') or (build_type == 'snapshot') or (build_type == 'prerelease') %}
  {%- set rfs_image = "agl-ivi-demo-qt-crosssdk-sparrow-hawk.ext4.xz" %}
{%- else %}
  {%- set rfs_image = "agl-ivi-demo-qt-sparrow-hawk.ext4.xz" %}
{%- endif %}

{%- set initrd = "initramfs-netboot-image-sparrow-hawk.ext4.gz" %}
{%- set yocto_machine = "sparrow-hawk" %}
